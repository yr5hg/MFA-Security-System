
# Kali Linux MFA Project - Example Configuration
# Password + TOTP or Human Face Verification
# All computer-side components run locally on Kali Linux.
# Configure the hostnames, services, and private files before use.
# Never store real passwords, tokens, or secrets in this file.

# Application
GATE_ORIGIN=https://gate.test:8444
GATE_LISTEN_HOST=127.0.0.1

# Keycloak Authentication
KEYCLOAK_ISSUER=https://id.test:8443/realms/mfa-lab
KEYCLOAK_TOTP_CLIENT_ID=gate-totp
KEYCLOAK_FACE_CLIENT_ID=gate-face
RESOURCE_AUDIENCE=lab-resource

# Keycloak Client Secrets
TOTP_CLIENT_SECRET_FILE=/etc/mfa-lab/totp-client.secret
FACE_CLIENT_SECRET_FILE=/etc/mfa-lab/face-client.secret

# HTTPS Configuration
LAB_CA_FILE=/etc/mfa-lab/lab-ca.crt
GATE_TLS_CERT_FILE=/etc/mfa-lab/gate.crt
GATE_TLS_KEY_FILE=/etc/mfa-lab/gate.key

# Private Storage
PRIVATE_STATE_DIR=/var/lib/mfa-lab

# Human Face Verification
HUMAN_MODEL_DIR=/opt/mfa-lab/models

# Set after testing and calibrating face similarity.
# An empty value disables the face verification route.
FACE_SIMILARITY_THRESHOLD=

# Authentication Time Limits
ATTEMPT_TTL_SECONDS=300
CAPTURE_CHALLENGE_TTL_SECONDS=60
APPROVAL_TTL_SECONDS=600

# Face Verification Limits
INFERENCE_TIMEOUT_MS=10000
CAPTURE_MAX_BYTES=1048576

# Failed Face Verification Attempts
FACE_FAILURE_LIMIT=3
FACE_FAILURE_WINDOW_SECONDS=300
FACE_COOLDOWN_SECONDS=300
